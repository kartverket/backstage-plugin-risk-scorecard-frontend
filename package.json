{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "workspaces": {
    "packages": [
      "plugins/ros",
      "build-tools"
    ]
  },
  "scripts": {
    "prettier:check": "prettier --check \"plugins/*/src/**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"build-tools/**/*.ts\"",
    "prettier:format": "prettier --write \"plugins/*/src/**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"build-tools/**/*.ts\"",
    "lint": "eslint \"plugins/*/src/**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"build-tools/**/*.ts\"",
    "test": "yarn workspaces foreach -A --exclude build-tools run test --watchAll=false && yarn workspace build-tools test",
    "typecheck": "tsc -p plugins/ros --noEmit && tsc -p build-tools",
    "backstage:upgrade": "yarn workspace @kartverket/backstage-plugin-risk-scorecard backstage-cli versions:bump",
    "kartverket.dev": "sh scripts/runKartverketDev.sh"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "catalog:",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@types/react": "18.3.12",
    "@yarnpkg/core/got": "^11.7.0"
  },
  "packageManager": "yarn@4.14.1"
}
